{
  "name": "kimjungho-agentic-ai-workshop",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:day1 && npm run build:teaching && npm run build:sitemap && node scripts/build-sites-static.mjs",
    "build:day1": "node scripts/finalize-day1-static.mjs",
    "build:teaching": "node scripts/refresh-teaching-navigation.mjs",
    "build:sitemap": "node scripts/generate-sitemap.mjs",
    "enrich:images": "node scripts/enrich-image-metadata.mjs",
    "enrich:pages": "node scripts/enrich-page-metadata.mjs",
    "generate:week09-assets": "python3 scripts/generate-week09-data-assets.py",
    "setup:week09-assets": "python3 -m pip install -r requirements-week09-assets.txt",
    "test:week09-assets": "WEEK09_STRICT_ASSET_TEST=1 node --test --test-name-pattern='week 9 generated assets stay reproducible' tests/contents-programming-week09.test.mjs",
    "generate:week10-assets": "python3 scripts/generate-week10-map-assets.py && python3 scripts/generate-week10-map-mission.py",
    "setup:week10-assets": "python3 -m pip install -r requirements-week10-assets.txt",
    "test:week10-assets": "WEEK10_STRICT_ASSET_TEST=1 WEEK10_STRICT_NOTEBOOK_TEST=1 node --test tests/contents-programming-week10.test.mjs",
    "generate:week11-assets": "python3 scripts/generate-week11-data-poster-assets.py",
    "setup:week11-assets": "python3 -m pip install -r requirements-week11-assets.txt",
    "test:week11-assets": "WEEK11_STRICT_ASSET_TEST=1 WEEK11_STRICT_NOTEBOOK_TEST=1 node --test tests/contents-programming-week11.test.mjs",
    "generate:week14-assets": "python3 scripts/generate-week14-project-assets.py",
    "setup:week14-assets": "python3 -m pip install -r requirements-week14-assets.txt",
    "test:week14-assets": "WEEK14_STRICT_ASSET_TEST=1 WEEK14_STRICT_NOTEBOOK_TEST=1 node --test tests/contents-programming-week14.test.mjs",
    "generate:week15-assets": "python3 scripts/generate-week15-project-assets.py",
    "setup:week15-assets": "python3 -m pip install -r requirements-week15-assets.txt",
    "test:week15-assets": "WEEK15_STRICT_ASSET_TEST=1 WEEK15_STRICT_NOTEBOOK_TEST=1 node --test tests/contents-programming-week15.test.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
